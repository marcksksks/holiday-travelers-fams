APP_NAME="FAMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fams
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=fams_session

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Sanctum / CORS ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000

# --- Mail (notifications) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@fams.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Google Calendar integration (visitor sync) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE="Asia/Singapore"

# --- AI visitor-assist (optional; falls back to rule-based suggestions if unset) ---
AI_ASSIST_PROVIDER=none
AI_ASSIST_API_KEY=
AI_ASSIST_MODEL=

FILESYSTEM_DISK=local
AI_ASSIST_ENDPOINT=
